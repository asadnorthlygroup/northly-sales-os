NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (for NORI + proposal drafting + PDF ingestion)
ANTHROPIC_API_KEY=sk-ant-...

# Close CRM
CLOSE_API_KEY=api_...

# Apify (Instagram, TikTok, Facebook scraping)
APIFY_API_TOKEN=apify_api_...

# YouTube Data API v3
YOUTUBE_API_KEY=AIza...

# Google Workspace (service account for Docs/Drive)
GOOGLE_SERVICE_ACCOUNT_EMAIL=sales-os@northlygroup.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
GOOGLE_DRIVE_TEMPLATE_FOLDER_ID=your-folder-id
GOOGLE_DRIVE_GENERATED_FOLDER_ID=your-folder-id

# QuickBooks
QUICKBOOKS_CLIENT_ID=your-client-id
QUICKBOOKS_CLIENT_SECRET=your-client-secret
